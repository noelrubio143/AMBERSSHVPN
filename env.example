# Firebase Configuration
# Get this from your Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Convert the JSON to a single-line string and paste here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# PayMongo Configuration
# Get your Secret Key from PayMongo Dashboard > Account Settings > API Keys
PAYMONGO_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Subscription Settings
# Amount in centavos (100 centavos = PHP 1.00)
# Default: 9900 centavos = PHP 99.00
SUBSCRIPTION_PRICE_CENTAVOS=9900

# Redirect URLs (after payment)
SUCCESS_REDIRECT_URL=https://noelrubio143.github.io/AMBERSSHVPN/payment-success.html
FAILED_REDIRECT_URL=https://noelrubio143.github.io/AMBERSSHVPN/payment-failed.html

# Node Environment
NODE_ENV=production

# Port (only for local development)
PORT=3000
