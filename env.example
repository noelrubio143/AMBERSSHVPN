# PayMongo secret key (from PayMongo Dashboard > Developers > API Keys)
# Use the TEST key first (sk_test_...) until you're ready to go live (sk_live_...)
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# The full contents of your Firebase service account JSON file,
# pasted as ONE LINE (see README for how to convert it).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ambervpn-c7814", ...}

# Subscription price in centavos. 9900 = P99.00
SUBSCRIPTION_PRICE_CENTAVOS=9900

# Pages the user lands on after paying (can be simple GitHub Pages files)
SUCCESS_REDIRECT_URL=https://noelrubio143.github.io/AMBERSSHVPN/payment-success.html
FAILED_REDIRECT_URL=https://noelrubio143.github.io/AMBERSSHVPN/payment-failed.html
