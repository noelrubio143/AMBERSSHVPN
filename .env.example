# AMBERSSHVPN Backend - Environment Variables

# Firebase Configuration (existing)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# PayMongo Configuration (existing)
PAYMONGO_SECRET_KEY=sk_your_paymongo_secret_key
PAYMONGO_PUBLIC_KEY=pk_your_paymongo_public_key

# GCash Configuration (🆕 NEW)
GCASH_MERCHANT_ID=your-gcash-merchant-id
GCASH_WEBHOOK_SECRET=your-gcash-webhook-secret

# Maya Configuration (🆕 NEW)
MAYA_MERCHANT_ID=your-maya-merchant-id
MAYA_API_KEY=your-maya-api-key
MAYA_WEBHOOK_SECRET=your-maya-webhook-secret

# Application Configuration
BASE_URL=https://ambersshvpn.vercel.app
ANDROID_APP_BASE_URL=https://ambersshvpn.vercel.app

# Subscription Settings
SUBSCRIPTION_PRICE_PESOS=50
SUBSCRIPTION_DAYS=30
GCASH_PAYMENT_EXPIRY_MINUTES=30
MAYA_PAYMENT_EXPIRY_HOURS=24
